{
  "name": "fm-deal-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Reads MapleStory Classic World player shops off your screen and flags listings under their usual price.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run -c vitest.ocr.config.ts",
    "record-ocr": "tsx scripts/record-ocr.ts",
    "record-hover": "tsx scripts/record-hover.ts",
    "items": "tsx scripts/fetch-items.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
